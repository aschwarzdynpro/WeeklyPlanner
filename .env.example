# Optional: nur nötig, wenn der Plan zwischen mehreren Geräten
# synchronisiert werden soll. Ohne diese Werte speichert die App
# alles lokal im Browser.
#
# Beide Werte stehen im Supabase-Dashboard unter
# Project Settings → API. Der "anon"-Key ist für den Browser gedacht
# und darf öffentlich sein – der service_role-Key gehört NIE hierher.

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key
