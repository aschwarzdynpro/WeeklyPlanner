{
  "name": "weekly-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Familien-Wochenplaner: Essensplan, Rezepte, Einkaufsliste und Termine inkl. Bettdienst",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "esbuild scripts/generate-icons.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/icons.mjs && node node_modules/.cache/icons.mjs",
    "cookidoo:spike": "esbuild supabase/functions/cookidoo/client.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/cookidoo-client.mjs && node scripts/cookidoo-spike.mjs",
    "plan": "esbuild scripts/generate-plan.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/plan.mjs && node node_modules/.cache/plan.mjs > docs/Wochenplan.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.9"
  }
}
